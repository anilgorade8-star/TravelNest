<% layout("layout/boilerplate.ejs") -%>

<body>
<div class="container mt-4">
    <h2 class="mb-4">Add New Listing</h2>

    <form class="create-form" method="POST" action="/listing">

        <!-- Title -->
        <div class="input-group mb-3">
            <span class="input-group-text">🏠</span>
            <input
                type="text"
                class="form-control"
                name="listing[title]"
                placeholder="Title"
                required
            >
        </div>

        <!-- Description -->
        <div class="input-group mb-3">
            <span class="input-group-text">📝</span>
            <textarea
                class="form-control"
                name="listing[description]"
                placeholder="Description"
            ></textarea>
        </div>

        <!-- Image URL -->
        <div class="input-group mb-3">
            <span class="input-group-text">🔗</span>
            <input
                type="url"
                class="form-control"
                name="listing[image][url]"
                placeholder="Image URL"
                required
            >
        </div>

        <!-- Price -->
        <div class="input-group mb-3">
            <span class="input-group-text">₹</span>
            <input
                type="number"
                class="form-control"
                name="listing[price]"
                placeholder="Price"
                required
            >
            <span class="input-group-text">.00</span>
        </div>

        <!-- Location -->
        <div class="input-group mb-3">
            <span class="input-group-text">📍</span>
            <input
                type="text"
                class="form-control"
                name="listing[location]"
                placeholder="Location"
                required
            >
        </div>

        <!-- Country -->
        <div class="input-group mb-3">
            <span class="input-group-text">🌍</span>
            <input
                type="text"
                class="form-control"
                name="listing[country]"
                placeholder="Country"
                required
            >
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-success">
            Add Listing
        </button>

    </form>
</div>
</body>