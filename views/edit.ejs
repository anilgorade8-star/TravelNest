<% layout("layout/boilerplate.ejs") -%>

<body>
<div class="container mt-4">
    <form class="create-form" method="POST" action="/listing/<%= listing._id %>?_method=PUT">

        <!-- Title -->
        <div class="input-group mb-3">
            <span class="input-group-text">🏠</span>
            <input
                type="text"
                class="form-control"
                name="listing[title]"
                placeholder="Title"
                value="<%= listing.title %>"
                required
            >
        </div>

        <!-- Description -->
        <div class="input-group mb-3">
            <span class="input-group-text">📝</span>
            <textarea
                class="form-control"
                name="listing[description]"
                placeholder="Description"
            ><%= listing.description %></textarea>
        </div>

        <!-- Image URL -->
        <div class="input-group mb-3">
            <span class="input-group-text">🔗</span>
            <input
                type="url"
                class="form-control"
                name="listing[image][url]"
                placeholder="Image URL"
                value="<%= listing.image.url %>"
            >
        </div>

        <!-- Price -->
        <div class="input-group mb-3">
            <span class="input-group-text">₹</span>
            <input
                type="number"
                class="form-control"
                name="listing[price]"
                placeholder="Price"
                value="<%= listing.price %>"
            >
            <span class="input-group-text">.00</span>
        </div>

        <!-- Location -->
        <div class="input-group mb-3">
            <span class="input-group-text">📍</span>
            <input
                type="text"
                class="form-control"
                name="listing[location]"
                placeholder="Location"
                value="<%= listing.location %>"
            >
        </div>

        <!-- Button -->
        <button type="submit" class="btn btn-primary">
            Edit Listing
        </button>

    </form>
</div>
</body>